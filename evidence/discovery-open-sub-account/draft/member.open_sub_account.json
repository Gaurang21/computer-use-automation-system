{
  "kind": "capability",
  "schemaVersion": "1.0",
  "id": "member.open_sub_account",
  "version": "1.0.0",
  "title": "Open a new sub-account for a member",
  "description": "Finds a member by ID, opens a new sub-account with the given account type, nickname and opening deposit, reviews it, and submits it. Returns the new account number (newAccountNumber); this creates a real account and cannot be undone.",
  "app": {
    "appId": "memberdesk",
    "versions": ">=7.2 <8"
  },
  "risk": "irreversible",
  "status": "draft",
  "inputs": {
    "memberId": {
      "type": "string",
      "sensitivity": "identifier",
      "pattern": "^\\d{5}$",
      "required": true
    },
    "accountType": {
      "type": "enum",
      "sensitivity": "none",
      "enum": [
        "Savings",
        "Money Market",
        "Certificate"
      ],
      "required": true
    },
    "nickname": {
      "type": "string",
      "sensitivity": "none",
      "pattern": "^.{1,24}$",
      "required": true
    },
    "openingDeposit": {
      "type": "money",
      "sensitivity": "financial",
      "required": true
    }
  },
  "outputs": {
    "newAccountNumber": {
      "type": "string",
      "sensitivity": "identifier",
      "description": "Number of the account just opened",
      "required": true
    }
  },
  "preconditions": [
    {
      "capability": "auth.login"
    }
  ],
