      "type": "string",
      "sensitivity": "identifier",
      "description": "Five digit member ID",
      "pattern": "^\\d{5}$",
      "required": true
    }
  },
  "outputs": {
    "memberName": {
      "type": "string",
      "sensitivity": "pii",
      "description": "Member's full name",
      "required": true
    },
    "savingsBalance": {
      "type": "money",
      "sensitivity": "financial",
      "description": "Current savings balance",
      "required": true
    }
  },
