{
  "kind": "capability",
  "schemaVersion": "1.0",
  "id": "member.lookup_savings_balance",
  "version": "1.0.0",
  "title": "Look up a member's name and savings balance",
  "description": "Searches Member Search by the given member ID, then reads the member's full name (memberName) and savings account balance (savingsBalance) from the Member Detail page. Read-only: nothing is changed in the system.",
