{
  "name": "computer-use-automation-system",
  "version": "0.1.0",
  "private": true,
  "description": "LLM-driven discovery of legacy back-office UI flows, compiled into typed capabilities that replay deterministically.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "app": "tsx target-app/main.ts",
    "schemas": "tsx src/schema/export.ts",
    "replay": "tsx src/cli.ts replay",
    "approve": "tsx src/cli.ts approve",
    "discover": "tsx src/cli.ts discover"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "commander": "^15.0.0",
    "express": "^5.3.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "zod": "^4.6.6"
  }
}
