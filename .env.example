# Copy to .env and fill in. Never commit .env.

# Used only by discovery (the LLM-driven run). Replay never calls the model.
ANTHROPIC_API_KEY=

# Model used by the discovery agent loop.
CUA_MODEL=claude-sonnet-5-5

# Hard spend cap per discovery run, in USD. The run aborts when it is passed.
MAX_SPEND_USD=1.00

# Synthetic operator credentials for the local MemberDesk app (not real secrets).
MEMBERDESK_OPERATOR_ID=teller01
MEMBERDESK_OPERATOR_PASSWORD=change-me-local-only
